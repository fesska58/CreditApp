<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

        xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-status-history" author="fess">

        <createTable tableName="status_history">

            <column name="status_history_id" type="uuid">
                <constraints primaryKey="true"/>
            </column>

            <column name="statement_id" type="uuid"/>

            <column name="status" type="varchar(30)"/>

            <column name="time" type="timestamp"/>

            <column name="change_type" type="varchar(20)"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="status_history"
                baseColumnNames="statement_id"
                constraintName="fk_status_history_statement"
                referencedTableName="statement"
                referencedColumnNames="statement_id"/>

    </changeSet>

</databaseChangeLog>